# Base URL that browsers will use to reach this deployment.
# Must be publicly reachable from the visitors' browsers (not "localhost" if the
# tracker runs on a real site). Examples:
#   http://localhost:5000            -> local testing
#   http://192.168.1.20:5000         -> office LAN
#   https://tracker.miempresa.com    -> public server behind TLS
API_URL = http://localhost:5000

# Admin key. Protects the dashboard: used to log in and to read /api/stats and
# /api/visits. Keep it secret. Generate: https://www.random.org/strings
API_KEY = change_me_generate_a_long_random_string

# (Recommended) separate write-only key embedded in the PUBLIC tracker.js.
# It can ONLY record visits; it cannot read stats nor log into the dashboard.
# If empty, it falls back to API_KEY (single-key mode).
# Generate another random string and keep it different from API_KEY.
TRACKER_KEY = change_me_another_long_random_string

# Set to "true" only when serving behind HTTPS (reverse proxy / tunnel).
# Makes the dashboard session cookie Secure.
COOKIE_SECURE = false